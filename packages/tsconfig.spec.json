{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./",
    "types": [
      "vitest/globals"
    ],
    "paths": {
      "@ng-util/*": [
        "./*"
      ]
    },
    "esModuleInterop": true,
    "noImplicitThis": false
  },
  "include": [
    "**/*.spec.ts",
    "**/*.d.ts",
    "test-setup.ts"
  ]
}